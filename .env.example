# 融e衡 A/B 实验网页 —— 环境变量示例
# 复制为 .env.local 后再填写，切勿把真实密钥提交进仓库。

# 当前阶段（参与者端）默认使用浏览器本地存储，不需要以下变量即可运行。
# 接入 Supabase 时再填写，并只使用匿名公钥。
# 服务角色密钥（service_role key）禁止出现在这里、前端代码或浏览器请求中。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 数据写入通道：local = 浏览器本地存储（默认）；supabase = 远端集中存储（待接入）
VITE_DATA_BACKEND=local

# 冻结版本号。正式采集开始后不得随意变更，每次改动需记录日期与原因。
VITE_APP_VERSION=0.1.0-dev
